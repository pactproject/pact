<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%level %logger{40} - %msg%n</pattern></encoder>
    </appender>
    <logger name="org.apache.hc" level="WARN"/>
    <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
